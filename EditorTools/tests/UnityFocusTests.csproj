    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute><LangVersion>latest</LangVersion>
    <AssemblyName>Aviassembly.FocusRuntimeTests</AssemblyName>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Aviassembly</GameDir>

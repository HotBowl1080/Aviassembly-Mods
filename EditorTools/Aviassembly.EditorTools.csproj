<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Aviassembly.EditorTools</AssemblyName>
    <RootNamespace>Aviassembly.EditorTools</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Aviassembly</GameDir>
    <ManagedDir>$(GameDir)\Aviassembly_Data\Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <!-- Cancelled feature remains preserved on disk, excluded from this release. -->
    <Compile Remove="src\NamedSelections.cs;src\NamedSelectionsUI.cs" />
    <Reference Include="$(ManagedDir)\*.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
